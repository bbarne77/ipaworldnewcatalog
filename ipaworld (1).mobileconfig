	<key>PayloadUUID</key>
	<string>F54B3C9D-6B55-4E42-9F34-8C47C8D9A002</string>
	<key>PayloadDisplayName</key>
	<string>iPAWORLD — каталог приложений</string>
	<key>PayloadDescription</key>
	<string>iPAWORLD — каталог приложений для iPhone и iPad. Находите приложения и игры, скачивайте IPA-файлы и переходите к установке через Telegram-бота. Добавьте ярлык iPAWORLD на экран «Домой» для быстрого доступа к каталогу.</string>
	<key>PayloadOrganization</key>
	<string>iPAWORLD</string>
	<key>PayloadRemovalDisallowed</key>
	<false/>
