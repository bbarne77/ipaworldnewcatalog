	<string>iPAWORLD</string>
	<key>PayloadDescription</key>
	<string>iPAWORLD — удобный каталог приложений для iPhone. Находите приложения, банки и игры в одном месте, пользуйтесь быстрым поиском и получайте доступ к актуальному каталогу с экрана «Домой».</string>
	<key>PayloadOrganization</key>
	<string>iPAWORLD</string>
	<key>PayloadRemovalDisallowed</key>
	<false/>
