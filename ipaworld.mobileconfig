	<key>PayloadIdentifier</key>
	<string>info.ipaworld.catalog.profile</string>
	<key>PayloadUUID</key>
	<string>F54B3C9D-6B55-4E42-9F34-8C47C8D9A002</string>
	<key>PayloadDisplayName</key>
	<string>iPAWORLD</string>
	<key>PayloadDescription</key>
	<string>iPAWORLD — каталог приложений для iPhone и iPad. Находите приложения, игры и полезные сервисы, скачивайте IPA-файлы и переходите к установке через Telegram-бота. Добавьте iPAWORLD на экран «Домой» для быстрого доступа к каталогу.</string>
	<key>PayloadOrganization</key>
	<string>iPAWORLD</string>
	<key>PayloadRemovalDisallowed</key>
	<false/>
